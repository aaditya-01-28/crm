generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @db.VarChar(255)
  subdomain String?         @unique @db.VarChar(100)
  planTier  String          @default("internal") @map("plan_tier") @db.VarChar(50)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  callLogs  CallLog[]
  deals     Deal[]
  leads     Lead[]
  payments  Payment[]
  tasks                 ScheduledTask[]
  users                 User[]
  passwordResetRequests PasswordResetRequest[]

  @@map("organizations")
}

model User {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  fullName         String          @map("full_name") @db.VarChar(150)
  email            String          @unique @db.VarChar(255)
  passwordHash     String          @map("password_hash") @db.VarChar(255)
  phoneNumber      String?         @map("phone_number") @db.VarChar(20)
  role             String          @default("sales_rep") @db.VarChar(50)
  language         String          @default("en") @map("language") @db.VarChar(255)
  isActive         Boolean         @default(true) @map("is_active")
  resetToken       String?         @map("reset_token") @db.VarChar(255)
  resetTokenExpiry DateTime?       @map("reset_token_expiry") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  callLogs         CallLog[]
  deals            Deal[]
  assignedLeads    Lead[]          @relation("AssignedRep")
  firstAssignedLeads Lead[]        @relation("FirstAssignedRep")
  approvedPayments Payment[]       @relation("PaymentApprover")
  payments         Payment[]       @relation("PaymentRep")
  tasks                 ScheduledTask[]
  passwordResetRequests PasswordResetRequest[]
  tenant           Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Lead {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  assignedRepId    String?         @map("assigned_rep_id") @db.Uuid
  firstAssignedRepId String?       @map("first_assigned_rep_id") @db.Uuid
  firstAssignedAt  DateTime?       @map("first_assigned_at") @db.Timestamptz(6)
  phoneNumber      String          @map("phone_number") @db.VarChar(20)
  contactName      String?         @map("contact_name") @db.VarChar(150)
  companyName      String?         @map("company_name") @db.VarChar(200)
  websiteUrl       String?         @map("website_url") @db.VarChar(255)
  businessVertical String?         @map("business_vertical") @db.VarChar(100)
  serviceType      String?         @map("service_type") @db.VarChar(100)
  source           String          @default("Vendor Cold List") @db.VarChar(100)
  status           String          @default("new") @db.VarChar(50)
  rnrCount         Int             @default(0) @map("rnr_count")
  batchDate        DateTime        @default(dbgenerated("CURRENT_DATE")) @map("batch_date") @db.Date
  customMetadata   Json            @default("{}") @map("custom_metadata")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  callLogs         CallLog[]
  deals            Deal[]
  assignedRep      User?           @relation("AssignedRep", fields: [assignedRepId], references: [id])
  firstAssignedRep User?           @relation("FirstAssignedRep", fields: [firstAssignedRepId], references: [id])
  tenant           Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments         Payment[]
  tasks            ScheduledTask[]

  @@index([tenantId, status], map: "idx_leads_tenant_status")
  @@index([phoneNumber], map: "idx_leads_phone")
  @@map("leads")
}

model CallLog {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  leadId          String       @map("lead_id") @db.Uuid
  repId           String       @map("rep_id") @db.Uuid
  disposition     String       @db.VarChar(50)
  durationSeconds Int          @default(0) @map("duration_seconds")
  remark          String?
  callTimestamp   DateTime     @default(now()) @map("call_timestamp") @db.Timestamptz(6)
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rep             User         @relation(fields: [repId], references: [id])
  tenant          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([repId, callTimestamp], map: "idx_call_logs_rep_date")
  @@map("call_logs")
}

model ScheduledTask {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  leadId        String       @map("lead_id") @db.Uuid
  repId         String       @map("rep_id") @db.Uuid
  taskType      String       @map("task_type") @db.VarChar(50)
  scheduledTime DateTime?    @map("scheduled_time") @db.Timestamptz(6)
  status        String       @default("pending") @db.VarChar(20)
  meetingLink   String?      @map("meeting_link") @db.VarChar(255)
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rep           User         @relation(fields: [repId], references: [id])
  tenant        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("scheduled_tasks")
}

model Deal {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  leadId              String       @map("lead_id") @db.Uuid
  repId               String       @map("rep_id") @db.Uuid
  serviceType         String       @map("service_type") @db.VarChar(100)
  quantity            Int
  quotedPrice         Decimal      @map("quoted_price") @db.Decimal(12, 2)
  expectedClosingDate DateTime?    @map("expected_closing_date") @db.Date
  stage               String       @default("quote_sent") @db.VarChar(50)
  closingNotes        String?      @map("closing_notes")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  lead                Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rep                 User         @relation(fields: [repId], references: [id])
  tenant              Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments            Payment[]

  @@map("deals")
}

model Payment {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  dealId             String       @map("deal_id") @db.Uuid
  leadId             String       @map("lead_id") @db.Uuid
  repId              String       @map("rep_id") @db.Uuid
  userType           String       @map("user_type") @db.VarChar(20)
  panelUserId        String       @map("panel_user_id") @db.VarChar(100)
  creditsToAdd       Int          @map("credits_to_add")
  originalAmount     Decimal      @map("original_amount") @db.Decimal(12, 2)
  taxAmount          Decimal      @map("tax_amount") @db.Decimal(12, 2)
  tdsAmount          Decimal      @default(0) @map("tds_amount") @db.Decimal(12, 2)
  finalAmount        Decimal      @map("final_amount") @db.Decimal(12, 2)
  paymentMode        String       @map("payment_mode") @db.VarChar(50)
  gstin              String?      @db.VarChar(15)
  screenshotUrl      String       @map("screenshot_url")
  opsApprovalStatus  String       @default("pending_verification") @map("ops_approval_status") @db.VarChar(30)
  approvedBy         String?      @map("approved_by") @db.Uuid
  creditsProvisioned Boolean      @default(false) @map("credits_provisioned")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  approver           User?        @relation("PaymentApprover", fields: [approvedBy], references: [id])
  deal               Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead               Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rep                User         @relation("PaymentRep", fields: [repId], references: [id])
  tenant             Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PasswordResetRequest {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  status      String       @default("pending") @db.VarChar(30)
  requestedAt DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamptz(6)
  resolvedBy  String?      @map("resolved_by") @db.Uuid
  userNotes   String?      @map("user_notes")
  adminNotes  String?      @map("admin_notes")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "idx_pw_requests_tenant_status")
  @@map("password_reset_requests")
}

