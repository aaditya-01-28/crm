{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "textora-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_eval_during_startup"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
